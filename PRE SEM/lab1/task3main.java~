import java.util.Scanner;
import java.util.Arrays;
public class task3main{
  public static void main (String [] args){
    //input
    Scanner sc = new Scanner (System.in);
    System.out.print("N: ");
    int x = sc.nextInt();
    double [] arr1 = new double [x];
    for (int i =0 ; i<x ; i++){
      arr1[i] = sc.nextDouble;
    }
    double arr2 = new double [x];
    
   
    //calc
    int count =0;
    for (int i =0 ; i<x-1 ; i++){
      boolean uniq= true;
      if (arr1[i] == arr1[i+1]){
        uniq = false;
        count++;
      }
      if(uniq){
        arr2[i++] = arr1[i]; 
      }
    }
    double[] finarr = new double [count];
    for (int i =0 ; i<count ; i++){
      finarr[i]= arr2[i];
    }
    System.out.println(Arrays.toString(finarr));
    System.out.println(arr2.length - finarr.length);
  }
}